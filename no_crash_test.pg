BEGIN;

UPDATE edges SET cost = sign(cost);

SELECT CASE WHEN min_lib_version('4.1.0') THEN plan(32) ELSE plan(1) END;

PREPARE edges1 AS
SELECT id, source, target, cost FROM edges;

PREPARE edges2 AS
SELECT id, source, target, cost FROM edges;

PREPARE edges_1 AS
SELECT id, source, target, cost AS weight FROM edges;

PREPARE edges_2 AS
SELECT id, source, target, cost AS weight FROM edges;

CREATE OR REPLACE FUNCTION test_function()
RETURNS SETOF TEXT AS
$BODY$
DECLARE
params TEXT[];
subs TEXT[];
BEGIN

  subs = ARRAY['NULL']::TEXT[];

  IF min_lib_version('4.1.0') THEN

    -- direct SQL
    params = ARRAY['$$SELECT id, source, target, cost FROM edges$$']::TEXT[];
    RETURN QUERY SELECT * FROM no_crash_test('pgr_maximumWeightedMatching', params, subs);

    -- prepared statements
    params[1] := '$$edges1$$';
    RETURN QUERY SELECT * FROM no_crash_test('pgr_maximumWeightedMatching', params, subs);

    params[1] := '$$edges2$$';
    RETURN QUERY SELECT * FROM no_crash_test('pgr_maximumWeightedMatching', params, subs);

  ELSE
    RETURN QUERY SELECT skip(1, 'cost used in older versions');
    RETURN;
  END IF;

  -- alias variations (important for robustness)
  params[1] := '$$SELECT id, source, target, cost AS weight FROM edges$$';
  RETURN QUERY SELECT * FROM no_crash_test('pgr_maximumWeightedMatching', params, subs);

  params[1] := '$$edges_1$$';
  RETURN QUERY SELECT * FROM no_crash_test('pgr_maximumWeightedMatching', params, subs);

  params[1] := '$$edges_2$$';
  RETURN QUERY SELECT * FROM no_crash_test('pgr_maximumWeightedMatching', params, subs);

END
$BODY$
LANGUAGE plpgsql VOLATILE;

SELECT * FROM test_function();

SELECT finish();
ROLLBACK;
