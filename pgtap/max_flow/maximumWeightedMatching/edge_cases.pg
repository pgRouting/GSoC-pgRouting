BEGIN;

UPDATE edges SET cost = sign(cost);

SELECT plan(2);

PREPARE mwm_basic AS
SELECT * FROM pgr_maximumWeightedMatching(
  'SELECT id, source, target, cost FROM edges',
  false
);

PREPARE mwm_alias AS
SELECT * FROM pgr_maximumWeightedMatching(
  'SELECT id, source, target, cost AS weight FROM edges',
  false
);

SELECT CASE
WHEN min_lib_version('4.1.0') THEN lives_ok('mwm_basic','Basic weighted matching')
ELSE skip(1, 'pgr_maximumWeightedMatching introduced in newer version') END;

SELECT lives_ok('mwm_alias','Using cost alias as weight');

SELECT finish();
ROLLBACK;
