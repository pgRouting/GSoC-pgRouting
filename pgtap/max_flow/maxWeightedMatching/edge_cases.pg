BEGIN;

UPDATE edges SET cost = sign(cost), reverse_cost = sign(reverse_cost);
SELECT plan(1);

PREPARE noflag AS
SELECT * FROM pgr_maxWeightedMatching(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
   true
);



SELECT lives_ok('noflag','Using coming and going');

SELECT finish();
ROLLBACK;
