BEGIN;

SELECT CASE WHEN min_version('4.1.0') THEN plan(8) ELSE plan(1) END;

CREATE OR REPLACE FUNCTION edge_cases()
RETURNS SETOF TEXT AS
$BODY$
BEGIN

IF NOT min_version('4.1.0') THEN
  RETURN QUERY
  SELECT skip(1, 'Function is new on 4.1.0');
  RETURN;
END IF;

-- 0 edge, 0 vertex tests

RETURN QUERY
SELECT is_empty(
  $$SELECT id, source, target, cost, reverse_cost FROM edges WHERE id > 18$$,
  '1: Graph with 0 edges and 0 vertices is empty');

-- pgr_makeBiconnectedPlanar on empty graph returns empty
RETURN QUERY
SELECT is_empty(
  $$SELECT * FROM pgr_makeBiconnectedPlanar('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id > 18')$$,
  '2: Empty graph returns no edges to add');


-- 1 vertex test
-- Edge 5-5 (self loop), only vertex 5

RETURN QUERY
SELECT is_empty(
  $$SELECT * FROM pgr_makeBiconnectedPlanar('SELECT 1 AS id, 5 AS source, 5 AS target, 1.0 AS cost, -1.0 AS reverse_cost')$$,
  '3: Single vertex graph returns no edges to add');


-- 2 vertices test
-- Edge 5-6 (edge id=1 from sampledata)

RETURN QUERY
SELECT is_empty(
  $$SELECT * FROM pgr_makeBiconnectedPlanar('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id = 1')$$,
  '4: Two vertices (5--6) graph returns no edges to add');


-- 3 vertices test (Path graph: 5 -- 6 -- 10)
-- Edges 1 and 2: 5-6, 6-10
-- Path graph needs edge 5-10 to become biconnected

RETURN QUERY
SELECT set_eq(
  $$SELECT start_vid, end_vid FROM pgr_makeBiconnectedPlanar('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id IN (1, 2)')$$,
  $$VALUES (5::bigint, 10::bigint)$$,
  '5: Path graph 5--6--10 needs edge (5,10) to become biconnected');


-- 4 vertices test (Cycle graph: 7 -- 11 -- 8 -- 7 via edges 8, 10, 11, 12)
-- Already biconnected, so no edges should be added

RETURN QUERY
SELECT is_empty(
  $$SELECT * FROM pgr_makeBiconnectedPlanar('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id IN (8, 10, 11, 12)')$$,
  '6: Cycle graph (already biconnected) returns no edges to add');


-- Disjoint components test (P3 path + cycle)
-- Component 1: path 5--6--10 (needs edge 5-10)
-- Component 2: cycle 7--11--8--7 (already biconnected, needs nothing)

RETURN QUERY
SELECT set_eq(
  $$SELECT start_vid, end_vid FROM pgr_makeBiconnectedPlanar('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id IN (1, 2, 8, 10, 11, 12)')$$,
  $$VALUES (5::bigint, 10::bigint)$$,
  '7: Disjoint graphs processed independently, only P3 path needs edge (5,10)');


-- Non-planar graph test (K5: complete graph on 5 vertices)
-- K5 is not planar so function returns empty

RETURN QUERY
SELECT is_empty(
  $$SELECT * FROM pgr_makeBiconnectedPlanar('SELECT id, source, target, cost, reverse_cost FROM (VALUES
    (1, 1, 2, 1.0, -1.0), (2, 1, 3, 1.0, -1.0), (3, 1, 4, 1.0, -1.0), (4, 1, 5, 1.0, -1.0),
    (5, 2, 3, 1.0, -1.0), (6, 2, 4, 1.0, -1.0), (7, 2, 5, 1.0, -1.0),
    (8, 3, 4, 1.0, -1.0), (9, 3, 5, 1.0, -1.0),
    (10, 4, 5, 1.0, -1.0)
  ) AS t(id, source, target, cost, reverse_cost)')$$,
  '8: Non-planar graph (K5) returns no edges to add');

END;
$BODY$
LANGUAGE plpgsql;

SELECT edge_cases();

SELECT * FROM finish();
ROLLBACK;
