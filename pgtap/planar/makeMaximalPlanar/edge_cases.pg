BEGIN;

UPDATE edges SET cost = sign(cost), reverse_cost = sign(reverse_cost);
SELECT CASE WHEN min_version('4.1.0') THEN plan(8) ELSE plan(1) END;

CREATE OR REPLACE FUNCTION edge_cases()
RETURNS SETOF TEXT AS
$BODY$
BEGIN

IF NOT min_version('4.1.0') THEN
  RETURN QUERY
  SELECT skip(1, 'Function is new on 4.1.0');
  RETURN;
END IF;

-- 1. 0 edges test (Empty Graph)
PREPARE zeroEdgesTest AS
SELECT * FROM pgr_makeMaximalPlanar('SELECT id, source, target, cost FROM edges WHERE id > 1000');

RETURN QUERY
SELECT is_empty('zeroEdgesTest', '1: Empty, since input graph has 0 edges');


-- 2. 1 vertex test (Self-loop)
PREPARE oneVertexTest AS
SELECT * FROM pgr_makeMaximalPlanar('SELECT 1 AS id, 5 AS source, 5 AS target, 1.0 AS cost');

RETURN QUERY
SELECT is_empty('oneVertexTest', '2: Empty, since graph has only 1 vertex');


-- 3. 2 vertices test (Single edge 5--6)
PREPARE twoVerticesTest AS
SELECT * FROM pgr_makeMaximalPlanar('SELECT 1 AS id, 5 AS source, 6 AS target, 1.0 AS cost');

RETURN QUERY
SELECT is_empty('twoVerticesTest', '3: Empty, 2-vertex graph is already maximal planar');


-- 4. 3 vertices test (Path graph: 5--6--10)
PREPARE threeVerticesTest AS
SELECT start_vid, end_vid FROM pgr_makeMaximalPlanar(
  'SELECT id, source, target, cost FROM (VALUES (1, 5, 6, 1.0), (2, 6, 10, 1.0)) AS t(id, source, target, cost)'
);

RETURN QUERY
SELECT set_eq('threeVerticesTest', $$VALUES (5::bigint, 10::bigint)$$, '4: P3 graph bridged with (5,10)');


-- 5. 4 vertices test (Square C4 cycle: 1-2-3-4-1)
PREPARE fourVerticesCycleTest AS
SELECT start_vid, end_vid FROM pgr_makeMaximalPlanar(
  'SELECT id, source, target, cost FROM (VALUES (1, 1, 2, 1.0), (2, 2, 3, 1.0), (3, 3, 4, 1.0), (4, 4, 1, 1.0)) AS t(id, source, target, cost)'
);

RETURN QUERY
SELECT isnt_empty('fourVerticesCycleTest', '5: Square C4 cycle returns 1 diagonal edge to triangulate');


-- 6. Disconnected Forest Graph test (Disjoint trees: 1--2 and 3--4)
PREPARE forestGraphTest AS
SELECT start_vid, end_vid FROM pgr_makeMaximalPlanar(
  'SELECT id, source, target, cost FROM (VALUES (1, 1, 2, 1.0), (2, 3, 4, 1.0)) AS t(id, source, target, cost)'
);

RETURN QUERY
SELECT is_empty('forestGraphTest', '6: Disconnected forest graph returns empty set');


-- 7. Disjoint graphs from sampledata
PREPARE sampleDisjointTest AS
SELECT start_vid, end_vid FROM pgr_makeMaximalPlanar(
  'SELECT id, source, target, cost FROM edges WHERE id IN (1, 2, 8, 10, 11, 12)'
);

RETURN QUERY
SELECT isnt_empty('sampleDisjointTest', '7: Disjoint road network processed independent of components');


-- 8. Non-planar graph test (K5 complete graph)
PREPARE nonPlanarTest AS
SELECT * FROM pgr_makeMaximalPlanar(
  'SELECT id, source, target, cost FROM (VALUES ' ||
  '(1,1,2,1.0), (2,1,3,1.0), (3,1,4,1.0), (4,1,5,1.0), ' ||
  '(5,2,3,1.0), (6,2,4,1.0), (7,2,5,1.0), ' ||
  '(8,3,4,1.0), (9,3,5,1.0), (10,4,5,1.0)) AS t(id, source, target, cost)'
);

RETURN QUERY
SELECT is_empty('nonPlanarTest', '8: Non-planar K5 graph returns empty set');

END;
$BODY$
LANGUAGE plpgsql;

SELECT edge_cases();

SELECT * FROM finish();
ROLLBACK;
