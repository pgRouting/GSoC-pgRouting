BEGIN;

UPDATE edges SET cost = sign(cost), reverse_cost = sign(reverse_cost);
SELECT CASE WHEN NOT min_version('4.1.0') THEN plan(1) ELSE plan(5) END;

PREPARE edges_q AS
SELECT id, source, target, cost, reverse_cost  FROM edges;

CREATE OR REPLACE FUNCTION no_crash()
RETURNS SETOF TEXT AS
$BODY$
DECLARE
params TEXT[];
subs TEXT[];
BEGIN
  IF NOT min_version('4.1.0') THEN
    RETURN QUERY
    SELECT skip(1, 'Function is new on 4.1.0');
    RETURN;
  END IF;

  RETURN QUERY
  SELECT isnt_empty('edges_q', 'Should be not empty to tests be meaningful');

    params = ARRAY[
    '$$SELECT id, source, target, cost, reverse_cost  FROM edges$$'
    ]::TEXT[];
    subs = ARRAY[
    'NULL'
    ]::TEXT[];

    RETURN query SELECT * FROM no_crash_test('pgr_coreNumbers', params, subs);

END
$BODY$
LANGUAGE plpgsql VOLATILE;


SELECT * FROM no_crash();

SELECT finish();
ROLLBACK;
